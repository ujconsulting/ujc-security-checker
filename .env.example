# Security mailbox for tools/disclosures/ (sending disclosures, reading answers).
# Copy to .env (gitignored). Loaded via vault_env.load_vault_env (location: UJC_VAULT_ENV),
# ${vault:...} is resolved on loading. Comments only on lines of their own.
# encryption: ssl = implicit TLS (IMAP 993 / SMTP 465), tls = STARTTLS (IMAP 143 / SMTP 587).

# Address of the mailbox (From, Message-ID domain, own-mail detection). Optional: without it
# security_mail_username_out is used. mail_report.py refuses to send with the placeholder.
security_mail_address=security@example.org
# Display name in the From header of security reports (default: Security Team)
security_mail_sender_name=Example Security Team

# Incoming (IMAP)
security_mail_host_in=imap.example.org
security_mail_port_in=993
security_mail_encryption_in=ssl
security_mail_username_in=security@example.org
security_mail_password_in=${vault:ujc-security-checker/security_mail_password_in}

# Outgoing (SMTP)
security_mail_host_out=smtp.example.org
security_mail_port_out=465
security_mail_encryption_out=ssl
security_mail_username_out=security@example.org
security_mail_password_out=${vault:ujc-security-checker/security_mail_password_out}

# Codex cross-check of every disclosure text before approval and submission
# (tools/disclosures/codex_check.py run). on = approval.py grant and the submit tools refuse
# without a "CHECK: CONFIRMED" for exactly the current draft text; critical = only for drafts
# with severity_class critical; off or absent = not required.
disclosure_codex_check=on
disclosure_codex_model=gpt-6.1-sol
disclosure_codex_effort=medium
# Channels whose texts need the cross-check (default: all four).
disclosure_codex_channels=issue,comment,advisory,email
# Time limit of one Codex run in seconds (also used by the finding checks).
disclosure_codex_timeout=1500

# ---------------------------------------------------------------------------------------------
# claudex integration: Codex (via tools/codex_ro.py, read-only) checks the FINDING before it goes
# to a foreign repository, not only the wording. Switch values: off | critical | all.
# A record is bound to the finding fields of the draft (finding, severity, rating, upstream_ref,
# exposure), so rewording the text keeps it; changing the finding or its rating needs a new run.
# Model/effort empty = role configuration of claudex-loop (claudex_loop_dir), else the default.
# ---------------------------------------------------------------------------------------------

# Optional: checkout of claudex-loop; its scripts/claudex_roles.py --spec <role> supplies model
# and effort where they are not set here (roles code-review, exposure-review, audit).
claudex_loop_dir=

# Finding validation (codex_check.py finding): real at the referenced commit, preconditions,
# severity class and CVSS/CWE supported by the code, not by design per the policy.
# Last line FINDING: CONFIRMED | NOT CONFIRMED | SEVERITY WRONG - only CONFIRMED passes.
claudex_finding_check=critical
claudex_finding_model=
claudex_finding_effort=

# Exposure pass (codex_check.py exposure, claudex-loop role exposure-review): reachable from
# outside the machine? EXPOSURE: UNSAFE | SAFE. Blocks if it contradicts the draft field
# "exposure" (network|local); a critical finding with SAFE needs "exposure_override".
claudex_exposure_check=critical
claudex_exposure_model=
claudex_exposure_effort=

# Codex half of the initial audit in tool-review step 5. The Claude sub-agent audit runs in
# every mode; this only chooses what Codex does next to it (the main model verifies both):
# form  = one Codex run with the audit form of AGENTS.md via tools/codex_ro.py (default)
# audit = the claudex-loop skill /audit: Claude slices the repository and runs the scanners,
#         one fresh read-only Codex session judges each slice (plus exposure sessions), Claude
#         triages and writes a baseline file
# both  = form and audit, one after the other (never in parallel)
claudex_audit_mode=form
claudex_audit_model=
claudex_audit_effort=

# ---------------------------------------------------------------------------------------------
# Code hosts besides github.com (tools/disclosures/forge.py, tools/quarantine_clone.py).
# Address a repository as <alias>:owner/name (GitLab subgroups: <alias>:group/sub/name); in
# drafts and the register the alias is the field "forge". github.com needs no entry (gh CLI).
# Check the setup with: python tools/disclosures/forge.py list | check <alias> [--repo o/n]
# ---------------------------------------------------------------------------------------------

# Aliases in use (optional - blocks with forge_<alias>_type are found anyway).
forges=

# One block per forge. type: github (GitHub Enterprise Server / own GitHub server, via
# gh --hostname), gitea (also Forgejo), gitlab (gitlab.com or self-managed), git (no API:
# local path, file://, ssh:// or https:// of any git server - clone and policy only, no issues).
# url: web base URL (type git: base path or base URL the repository path is appended to).
# api: only if it differs from the default (github <url>/api/v3, gitea <url>/api/v1,
# gitlab <url>/api/v4). token: from the vault, never in plain text. user: user name for git
# over HTTPS (default oauth2 on GitLab, x-access-token on GitHub, token on Gitea).
# ca_bundle: PEM file of an own CA. tls_verify=off only for a lab host (prints a warning).
# allow_http=on only for a LAN host without TLS (the token then travels in clear text).
# write=on allows the submit tools to create issues/comments there (default off; the
# hash-bound approval is still required). accounts: own logins on this host (watch, own repos).
#
# forge_lan_type=gitea
# forge_lan_url=https://git.example.net
# forge_lan_token=${vault:ujc-security-checker/forge_lan_token}
# forge_lan_write=off
# forge_lan_accounts=
#
# forge_corp_type=gitlab
# forge_corp_url=https://gitlab.example.org
# forge_corp_token=${vault:ujc-security-checker/forge_corp_token}
# forge_corp_ca_bundle=
# forge_corp_write=off
#
# forge_ghe_type=github
# forge_ghe_url=https://github.example.com
# forge_ghe_token=${vault:ujc-security-checker/forge_ghe_token}
#
# forge_raw_type=git
# forge_raw_url=/srv/git

# CodeRabbit full review (tools/cr_full_review.sh) - sends code to a third party, so opt-in:
# on = part of the pipeline; off or absent = the script refuses before anything is sent.
# Non-public revisions additionally need UJC_CR_PRIVATE_APPROVAL=<sha> per run.
coderabbit_review=off
